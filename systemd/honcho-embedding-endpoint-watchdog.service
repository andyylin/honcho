[Unit]
Description=Honcho embedding endpoint fallback watchdog
Documentation=file:/home/pi/honcho/scripts/honcho_embedding_endpoint_watchdog.py
Wants=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/honcho
Environment=HOME=/home/pi
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HONCHO_DIR=/home/pi/honcho
Environment=HONCHO_REMOTE_EMBEDDING_BASE_URL=http://172.18.0.1:11435/v1
# Deliberately no Pi-local automatic fallback; use the same remote endpoint so
# remote failure alerts rather than loading a large model into Pi RAM/swap.
Environment=HONCHO_LOCAL_EMBEDDING_BASE_URL=http://172.18.0.1:11435/v1
Environment=HONCHO_LOCAL_OLLAMA_BASE_URL=http://localhost:11434
Environment=HONCHO_REMOTE_RESTORE_SUCCESS_THRESHOLD=15
Environment=HONCHO_REMOTE_REPAIR_INTERVAL_MINUTES=30
Environment=HONCHO_EMBEDDING_PROBE_TIMEOUT_SECONDS=180
Environment=HONCHO_REMOTE_AUTO_RESTORE=1
Environment=HONCHO_REMOTE_OLLAMA_PORT=11435
Environment=HONCHO_EMBEDDING_NOTIFY_MODE=digest
Environment=HONCHO_EMBEDDING_ALERT_TARGET=email:andylin@gmail.com
Environment="HONCHO_EMBEDDING_ALERT_SUBJECT=[Hermes][Honcho] Embedding fallback"
ExecStart=/usr/bin/python3 /home/pi/honcho/scripts/honcho_embedding_endpoint_watchdog.py
