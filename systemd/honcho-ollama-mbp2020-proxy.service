[Unit]
Description=Honcho MBP2020 Ollama SSH tunnel for Docker bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/honcho
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=accept-new -L 172.18.0.1:11435:127.0.0.1:11434 andylin@mbp2020.local
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
